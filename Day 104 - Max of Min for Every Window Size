// GFG 160 Days Challenge - Day 104
// Problem: Max of Min for Every Window Size
//
// Approach:
// 1. Use a monotonic increasing stack.
// 2. Find the previous smaller element for each element.
// 3. Find the next smaller element using stack processing.
// 4. Calculate the maximum window size where each element
//    can be the minimum.
// 5. Propagate maximum values from larger windows to
//    smaller windows.
//
// Time Complexity: O(n)
// Space Complexity: O(n)

class Solution {
public:
    vector<int> maxOfMins(vector<int>& arr) {
        int n = arr.size();

        vector<int> res(n, 0);
        vector<int> len(n + 1, 0);
        stack<int> st;

        // Find the maximum window size for each element
        for (int i = 0; i < n; i++) {

            while (!st.empty() &&
                   arr[st.top()] >= arr[i]) {

                int top = st.top();
                st.pop();

                int left = st.empty() ? -1 : st.top();
                int right = i;

                int w = right - left - 1;

                len[w] = max(len[w], arr[top]);
            }

            st.push(i);
        }

        // Process remaining elements
        while (!st.empty()) {
            int top = st.top();
            st.pop();

            int left = st.empty() ? -1 : st.top();
            int right = n;

            int w = right - left - 1;

            len[w] = max(len[w], arr[top]);
        }

        // Fill answers for smaller window sizes
        for (int i = n - 1; i >= 1; i--) {
            len[i] = max(len[i], len[i + 1]);
        }

        for (int i = 0; i < n; i++) {
            res[i] = len[i + 1];
        }

        return res;
    }
};

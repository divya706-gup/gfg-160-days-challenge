// Day 26 - Non-Overlapping Intervals

// Approach:
// 1. Sort intervals based on their ending time.
// 2. Keep track of the end time of the last non-overlapping interval.
// 3. If the current interval overlaps, remove it.
// 4. Otherwise, keep the interval and update the end time.

// Time Complexity: O(n log n)
// Space Complexity: O(1)

class Solution {
public:
    int minRemoval(vector<vector<int>> &intervals) {
        
        int n = intervals.size();
        int overlap = 0;

        // Sort by ending time
        sort(intervals.begin(), intervals.end(),
             [](vector<int>& a, vector<int>& b) {
                 return a[1] < b[1];
             });

        int end = intervals[0][1];

        for (int i = 1; i < n; i++) {
            
            // Overlapping interval
            if (intervals[i][0] < end) {
                overlap++;
            }
            else {
                // Non-overlapping interval
                end = intervals[i][1];
            }
        }

        return overlap;
    }
};

/*
    GFG 160 Days DSA Challenge
    Day 07 - Stock Buy and Sell - Multiple Transactions Allowed

    Problem:
    Given an array prices[], where prices[i] is the stock price
    on the ith day, find the maximum profit possible when
    multiple transactions are allowed.

    We can buy and sell multiple times, but can hold only
    one stock at a time.

    Example:
    Input  : [100, 180, 260, 310, 40, 535, 695]
    Output : 865

    Intuition:
    Whenever today's price is greater than yesterday's price,
    we can take that increase as profit.

    Approach:
    1. Initialize maximumProfit = 0.
    2. Traverse the array from index 1.
    3. If prices[i] > prices[i-1], add the difference to profit.
    4. Return the total profit.

    Time Complexity: O(n)
    Space Complexity: O(1)
*/

#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int maxProfit(vector<int>& prices) {

        int maximumProfit = 0;

        for (int i = 1; i < prices.size(); i++) {

            if (prices[i] > prices[i - 1]) {
                maximumProfit += prices[i] - prices[i - 1];
            }
        }

        return maximumProfit;
    }
};

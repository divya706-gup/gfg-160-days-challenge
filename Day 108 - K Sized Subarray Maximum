// GFG 160 Days Challenge - Day 108
// Problem: K Sized Subarray Maximum
//
// Approach:
// 1. Use a Deque to maintain indices of potential maximum elements.
// 2. Remove indices that are outside the current window.
// 3. Remove smaller elements from the back of the deque.
// 4. Insert the current index.
// 5. The front of the deque stores the maximum element's index.
//
// Time Complexity: O(n)
// Space Complexity: O(k)

class Solution {
public:
    vector<int> maxOfSubarrays(vector<int>& arr, int k) {
        deque<int> dq;
        vector<int> ans;

        int n = arr.size();

        for (int i = 0; i < n; i++) {

            // Remove indices outside the current window
            while (!dq.empty() && dq.front() <= i - k) {
                dq.pop_front();
            }

            // Remove smaller or equal elements
            while (!dq.empty() && arr[dq.back()] <= arr[i]) {
                dq.pop_back();
            }

            // Insert current index
            dq.push_back(i);

            // Store maximum for each complete window
            if (i >= k - 1) {
                ans.push_back(arr[dq.front()]);
            }
        }

        return ans;
    }
};

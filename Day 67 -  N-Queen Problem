// GFG 160 Days Challenge - Day 67
// Problem: N-Queen Problem
//
// Approach:
// 1. Use Backtracking to place queens row by row.
// 2. For every row, try placing the queen in each column.
// 3. Check whether the position is safe using:
//    - Column
//    - Left diagonal
//    - Right diagonal
// 4. If the position is safe, place the queen and move to the next row.
// 5. If no position works, backtrack and try another column.
//
// Time Complexity: O(N!)
// Space Complexity: O(N)

class Solution {
public:

    bool isSafe(int row, int col, int rows,
                int ld, int rd, int n) {

        return !((rows >> row) & 1) &&
               !((ld >> (row + col)) & 1) &&
               !((rd >> (row - col + n - 1)) & 1);
    }

    void nQueen(vector<vector<int>>& res,
                vector<int>& board,
                int col,
                int n,
                int rows,
                int ld,
                int rd) {

        if (col > n) {
            res.push_back(board);
            return;
        }

        for (int row = 1; row <= n; row++) {

            if (isSafe(row - 1, col - 1, rows, ld, rd, n)) {

                board.push_back(row);

                nQueen(res, board, col + 1, n,
                       rows | (1 << (row - 1)),
                       ld | (1 << (row + col - 2)),
                       rd | (1 << (row - col + n - 1)));

                board.pop_back();
            }
        }
    }

    vector<vector<int>> nQueen(int n) {

        vector<vector<int>> res;
        vector<int> board;

        nQueen(res, board, 1, n, 0, 0, 0);

        return res;
    }
};

/*
    GFG 160 Days DSA Challenge
    Day 03 - Reverse an Array

    Problem:
    Given an array of integers, reverse the array in-place.

    Example:
    Input : [1, 4, 3, 2, 6, 5]
    Output: [5, 6, 2, 3, 4, 1]

    Intuition:
    Use two pointers:
    - left starts from the beginning
    - right starts from the end

    Swap elements at left and right, then move both
    pointers towards the center.

    Approach:
    1. Initialize left = 0 and right = n - 1.
    2. While left < right:
       - Swap arr[left] and arr[right].
       - Increment left.
       - Decrement right.
    3. Array gets reversed in-place.

    Time Complexity: O(n)
    Space Complexity: O(1)
*/

#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    void reverseArray(vector<int>& arr) {

        int left = 0;
        int right = arr.size() - 1;

        while (left < right) {

            swap(arr[left], arr[right]);

            left++;
            right--;
        }
    }
};

// GFG 160 Days Challenge - Day 59
// Problem: Trapping Rain Water
//
// Approach:
// 1. Create leftMax[] where leftMax[i] stores the maximum
//    height from the left up to index i.
// 2. Create rightMax[] where rightMax[i] stores the maximum
//    height from the right up to index i.
// 3. At every index, the water trapped is:
//    min(leftMax[i], rightMax[i]) - arr[i]
// 4. Add the trapped water for every index.
//
// Time Complexity: O(n)
// Space Complexity: O(n)

class Solution {
public:
    int maxWater(vector<int> &arr) {

        int n = arr.size();

        vector<int> leftMax(n), rightMax(n);

        // Maximum height from the left
        leftMax[0] = arr[0];

        for (int i = 1; i < n; i++) {
            leftMax[i] = max(leftMax[i - 1], arr[i]);
        }

        // Maximum height from the right
        rightMax[n - 1] = arr[n - 1];

        for (int i = n - 2; i >= 0; i--) {
            rightMax[i] = max(rightMax[i + 1], arr[i]);
        }

        int maxWater = 0;

        // Calculate trapped water
        for (int i = 0; i < n; i++) {
            maxWater += min(leftMax[i], rightMax[i]) - arr[i];
        }

        return maxWater;
    }
};

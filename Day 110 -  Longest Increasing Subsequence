// GFG 160 Days Challenge - Day 110
// Problem: Longest Increasing Subsequence
//
// Approach:
// 1. Use recursion with memoization.
// 2. Find the LIS ending at each index.
// 3. Check all previous elements.
// 4. If arr[i] < arr[idx], extend the subsequence.
// 5. Store results in the DP array to avoid repeated calculations.
// 6. Return the maximum LIS length.
//
// Time Complexity: O(n^2)
// Space Complexity: O(n)

class Solution {
public:
    int solve(vector<int>& arr, vector<int>& dp, int idx) {

        if (idx == 0) {
            return 1;
        }

        if (dp[idx] != -1) {
            return dp[idx];
        }

        int len = 1;

        for (int i = 0; i < idx; i++) {
            if (arr[i] < arr[idx]) {
                len = max(len, solve(arr, dp, i) + 1);
            }
        }

        return dp[idx] = len;
    }

    int lis(vector<int>& arr) {
        int n = arr.size();

        if (n == 0) {
            return 0;
        }

        vector<int> dp(n, -1);
        int result = 1;

        for (int i = 0; i < n; i++) {
            result = max(result, solve(arr, dp, i));
        }

        return result;
    }
};

// GFG 160 Days Challenge - Day 113
// Problem: Longest Palindromic Subsequence
//
// Approach:
// 1. Reverse the given string.
// 2. Find the Longest Common Subsequence (LCS)
//    between the original and reversed strings.
// 3. Use a 2D DP table to calculate the LCS length.
// 4. Return dp[n][n].
//
// Time Complexity: O(n * n)
// Space Complexity: O(n * n)

class Solution {
public:
    int longestPalinSubseq(string &s) {
        int n = s.length();

        string rev(s.rbegin(), s.rend());

        vector<vector<int>> dp(
            n + 1, vector<int>(n + 1, 0)
        );

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {

                if (s[i - 1] == rev[j - 1]) {
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                }
                else {
                    dp[i][j] = max(
                        dp[i - 1][j],
                        dp[i][j - 1]
                    );
                }
            }
        }

        return dp[n][n];
    }
};

// GFG 160 Days Challenge - Day 32
// Problem: K-th Element of Two Arrays
//
// Approach:
// 1. Always perform binary search on the smaller array.
// 2. Divide both arrays into two parts.
// 3. The left part should contain exactly k elements.
// 4. Check the boundary elements of both partitions.
// 5. If the partition is correct, return the maximum element
//    from the left side.
//
// Time Complexity: O(log(min(n, m)))
// Space Complexity: O(log(min(n, m))) due to recursion

class Solution {
public:
    int kthElement(vector<int>& a, vector<int>& b, int k) {
        int n = a.size();
        int m = b.size();

        // Binary search on the smaller array
        if (n > m) {
            return kthElement(b, a, k);
        }

        int l = max(0, k - m);
        int e = min(n, k);

        while (l <= e) {
            int mid1 = l + (e - l) / 2;
            int mid2 = k - mid1;

            int l1 = (mid1 == 0) ? INT_MIN : a[mid1 - 1];
            int l2 = (mid2 == 0) ? INT_MIN : b[mid2 - 1];

            int r1 = (mid1 == n) ? INT_MAX : a[mid1];
            int r2 = (mid2 == m) ? INT_MAX : b[mid2];

            // Correct partition
            if (l1 <= r2 && l2 <= r1) {
                return max(l1, l2);
            }
            // Too many elements taken from a
            else if (l1 > r2) {
                e = mid1 - 1;
            }
            // Need more elements from a
            else {
                l = mid1 + 1;
            }
        }

        return -1;
    }
};
```



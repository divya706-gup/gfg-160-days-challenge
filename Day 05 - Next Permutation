/*
    GFG 160 Days DSA Challenge
    Day 05 - Next Permutation

    Problem:
    Find the lexicographically next greater permutation.
    If no greater permutation exists, return the smallest
    permutation.

    Intuition:
    To get the next permutation, we need to make the smallest
    possible increase from the right side.

    Approach:
    1. Find the pivot:
       First index from right where arr[i] < arr[i + 1].

    2. If no pivot exists:
       Array is in descending order.
       Reverse it to get the smallest permutation.

    3. Find the first element from the right greater than
       arr[pivot] and swap them.

    4. Reverse the suffix after pivot to make it minimum.

    Time Complexity: O(n)
    Space Complexity: O(1)
*/

#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    void nextPermutation(vector<int>& arr) {

        int n = arr.size();
        int pivot = -1;

        // Step 1: Find pivot
        for (int i = n - 2; i >= 0; i--) {
            if (arr[i] < arr[i + 1]) {
                pivot = i;
                break;
            }
        }

        // Already the largest permutation
        if (pivot == -1) {
            reverse(arr.begin(), arr.end());
            return;
        }

        // Step 2: Find element greater than pivot
        for (int i = n - 1; i > pivot; i--) {
            if (arr[i] > arr[pivot]) {
                swap(arr[i], arr[pivot]);
                break;
            }
        }

        // Step 3: Make suffix minimum
        reverse(arr.begin() + pivot + 1, arr.end());
    }
};

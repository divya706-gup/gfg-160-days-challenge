// GFG 160 Days Challenge - Day 37
// Problem: Rotate by 90 Degree
//
// Approach:
// 1. Reverse every row of the matrix.
// 2. Transpose the matrix by swapping elements across the diagonal.
// 3. These two operations rotate the matrix by 90 degrees anti-clockwise.
// 4. The matrix is modified in-place without using extra space.
//
// Time Complexity: O(n^2)
// Space Complexity: O(1)

class Solution {
public:
    void rotateMatrix(vector<vector<int>>& mat) {
        int n = mat.size();

        // Reverse every row
        for (int i = 0; i < n; i++) {
            reverse(mat[i].begin(), mat[i].end());
        }

        // Transpose the matrix
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                swap(mat[i][j], mat[j][i]);
            }
        }
    }
};

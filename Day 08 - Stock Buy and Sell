/*
    GFG 160 Days DSA Challenge
    Day 08 - Stock Buy and Sell - Max One Transaction

    Problem:
    Given an array of stock prices, find the maximum profit
    possible by making at most one transaction.

    One transaction = one buy + one sell.

    Example:
    Input  : [7, 10, 1, 3, 6, 9, 2]
    Output : 8

    Intuition:
    Keep track of the minimum price seen so far.
    For every current price, calculate the profit if we sell
    on that day.

    Approach:
    1. Store the first price as the minimum price.
    2. Traverse the array.
    3. Update the minimum price.
    4. Calculate current profit:
           prices[i] - minimumPrice
    5. Keep track of the maximum profit.

    Time Complexity: O(n)
    Space Complexity: O(1)
*/

#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int maxProfit(vector<int>& prices) {

        int mn = prices[0];
        int mx = 0;

        for (int i = 0; i < prices.size(); i++) {

            mn = min(mn, prices[i]);

            mx = max(mx, prices[i] - mn);
        }

        return mx;
    }
};

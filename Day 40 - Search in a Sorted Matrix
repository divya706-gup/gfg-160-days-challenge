// GFG 160 Days Challenge - Day 40
// Problem: Search in a Sorted Matrix
//
// Approach:
// 1. Each row of the matrix is sorted.
// 2. Apply Binary Search on every row.
// 3. If the middle element is equal to x, return true.
// 4. If the middle element is greater than x, search the left half.
// 5. Otherwise, search the right half.
// 6. If x is not found in any row, return false.
//
// Time Complexity: O(n * log(m))
// Space Complexity: O(1)

class Solution {
public:

    // Binary Search in a single row
    bool foundElement(vector<int>& arr, int x) {
        int l = 0;
        int h = arr.size() - 1;

        while (l <= h) {
            int mid = l + (h - l) / 2;

            if (arr[mid] == x) {
                return true;
            }
            else if (arr[mid] > x) {
                h = mid - 1;
            }
            else {
                l = mid + 1;
            }
        }

        return false;
    }

    bool searchMatrix(vector<vector<int>>& mat, int x) {
        int n = mat.size();

        for (int i = 0; i < n; i++) {
            if (foundElement(mat[i], x)) {
                return true;
            }
        }

        return false;
    }
};

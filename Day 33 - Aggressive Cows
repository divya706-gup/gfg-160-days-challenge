// GFG 160 Days Challenge - Day 33
// Problem: Aggressive Cows
//
// Approach:
// 1. Sort the stall positions.
// 2. Binary search on the minimum possible distance.
// 3. For each distance, greedily place cows in the stalls.
// 4. If k cows can be placed, try a larger distance.
// 5. Otherwise, reduce the distance.
//
// Time Complexity: O(n log n)
// Space Complexity: O(1)

class Solution {
public:
    bool checkCows(int mid, vector<int>& arr, int k) {
        int count = 1;
        int prev = arr[0];

        for (int i = 1; i < arr.size(); i++) {
            if (arr[i] - prev >= mid) {
                prev = arr[i];
                count++;
            }
        }

        return count >= k;
    }

    int aggressiveCows(vector<int>& arr, int k) {
        int n = arr.size();

        sort(arr.begin(), arr.end());

        int s = 1;
        int e = arr.back() - arr[0];
        int res = 0;

        while (s <= e) {
            int mid = s + (e - s) / 2;

            if (checkCows(mid, arr, k)) {
                res = mid;
                s = mid + 1;
            }
            else {
                e = mid - 1;
            }
        }

        return res;
    }
};

// GFG 160 Days Challenge - Day 97
// Problem: Merge K Sorted Linked Lists
//
// Approach:
// 1. Use Divide and Conquer to divide the K linked lists.
// 2. Recursively merge the left and right halves.
// 3. Merge two sorted linked lists using two pointers.
// 4. Return the head of the final merged list.
//
// Time Complexity: O(N log K)
// Space Complexity: O(log K) - Recursion Stack

class Solution {
public:

    // Merge two sorted linked lists
    Node* mergeTwoLists(Node* first, Node* second) {
        Node* dummy = new Node(-1);
        Node* tail = dummy;

        while (first && second) {
            if (first->data <= second->data) {
                tail->next = first;
                first = first->next;
            }
            else {
                tail->next = second;
                second = second->next;
            }

            tail = tail->next;
        }

        if (first) {
            tail->next = first;
        }

        if (second) {
            tail->next = second;
        }

        Node* result = dummy->next;
        delete dummy;

        return result;
    }

    // Divide and Conquer
    Node* mergeRange(vector<Node*>& arr, int start, int end) {

        if (start > end) {
            return nullptr;
        }

        if (start == end) {
            return arr[start];
        }

        int mid = start + (end - start) / 2;

        Node* first = mergeRange(arr, start, mid);
        Node* second = mergeRange(arr, mid + 1, end);

        return mergeTwoLists(first, second);
    }

    Node* mergeKLists(vector<Node*>& arr) {

        if (arr.empty()) {
            return nullptr;
        }

        return mergeRange(arr, 0, arr.size() - 1);
    }
};

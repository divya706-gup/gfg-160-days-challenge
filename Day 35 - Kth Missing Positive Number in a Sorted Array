// GFG 160 Days Challenge - Day 35
// Problem: Kth Missing Positive Number in a Sorted Array
//
// Approach:
// 1. Traverse the sorted array.
// 2. For every element arr[i], check if arr[i] is greater than k.
// 3. If arr[i] > k, then the kth missing positive number is k + i.
// 4. If no such element is found, return k + n.
//
// Example:
// Input: arr = [2, 3, 4, 7, 11], k = 5
// Output: 9
//
// Time Complexity: O(n)
// Space Complexity: O(1)

class Solution {
public:
    int kthMissing(vector<int> &arr, int k) {
        int n = arr.size();

        for (int i = 0; i < n; i++) {
            if (arr[i] > k) {
                return k + i;
            }
        }

        return k + n;
    }
};

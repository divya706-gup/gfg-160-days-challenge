// GFG 160 Days Challenge - Day 101
// Problem: Next Greater Element
//
// Approach:
// 1. Traverse the array from right to left.
// 2. Use a stack to maintain potential greater elements.
// 3. Remove elements smaller than or equal to the current element.
// 4. The stack top becomes the next greater element.
// 5. If the stack is empty, store -1.
// 6. Push the current element's index.
//
// Time Complexity: O(n)
// Space Complexity: O(n)

class Solution {
public:
    vector<int> nextLargerElement(vector<int>& arr) {
        int n = arr.size();

        vector<int> ans(n, -1);
        stack<int> st;

        for (int i = n - 1; i >= 0; i--) {

            // Remove elements that cannot be the answer
            while (!st.empty() && arr[st.top()] <= arr[i]) {
                st.pop();
            }

            // Find the next greater element
            if (!st.empty()) {
                ans[i] = arr[st.top()];
            }

            // Store current index
            st.push(i);
        }

        return ans;
    }
};

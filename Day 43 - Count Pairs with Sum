// GFG 160 Days Challenge - Day 43
// Problem: Count Pairs with Sum
//
// Approach:
// 1. Use an unordered_map to store the frequency of elements seen so far.
// 2. For every element, calculate its complement:
//    complement = target - arr[i]
// 3. If the complement exists in the map, add its frequency to the count.
// 4. Store the current element in the map.
//
// Time Complexity: O(n)
// Space Complexity: O(n)

class Solution {
public:
    int countPairs(vector<int>& arr, int target) {
        int count = 0;
        unordered_map<int, int> mp;

        for (int i = 0; i < arr.size(); i++) {
            int complement = target - arr[i];

            if (mp.find(complement) != mp.end()) {
                count += mp[complement];
            }

            mp[arr[i]]++;
        }

        return count;
    }
};

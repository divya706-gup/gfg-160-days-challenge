/*
    GFG 160 Days DSA Challenge
    Day 18 - Search Pattern

    Problem:
    Given a text string txt and a pattern string pat,
    find all starting indices (0-based) where pat occurs in txt.

    Approach:
    Use KMP (Knuth-Morris-Pratt) Pattern Matching.

    Step 1:
    Build the LPS (Longest Prefix which is also Suffix) array
    for the pattern.

    Step 2:
    Use the LPS array while searching so that we don't
    recheck characters unnecessarily.

    Time Complexity: O(n + m)
    Space Complexity: O(m)
*/

#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<int> search(string &pat, string &txt) {

        int m = pat.length();
        int n = txt.length();

        vector<int> result;

        if (m > n) {
            return result;
        }

        // Build LPS array
        vector<int> lps(m, 0);

        int len = 0;
        int i = 1;

        while (i < m) {

            if (pat[i] == pat[len]) {
                len++;
                lps[i] = len;
                i++;
            }
            else {

                if (len != 0) {
                    len = lps[len - 1];
                }
                else {
                    lps[i] = 0;
                    i++;
                }
            }
        }

        // KMP pattern matching
        int txtIdx = 0;
        int patIdx = 0;

        while (txtIdx < n) {

            if (pat[patIdx] == txt[txtIdx]) {

                patIdx++;
                txtIdx++;

                // Complete pattern found
                if (patIdx == m) {

                    result.push_back(txtIdx - patIdx);

                    // Continue searching for overlapping matches
                    patIdx = lps[patIdx - 1];
                }
            }
            else {

                if (patIdx != 0) {
                    patIdx = lps[patIdx - 1];
                }
                else {
                    txtIdx++;
                }
            }
        }

        return result;
    }
};

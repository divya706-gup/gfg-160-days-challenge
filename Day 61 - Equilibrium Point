// GFG 160 Days Challenge - Day 61
// Problem: Equilibrium Point
//
// Approach:
// 1. Calculate the prefix sum for every index.
// 2. Calculate the suffix sum for every index.
// 3. Compare prefixSum[i] and suffixSum[i].
// 4. If both are equal, return the current index.
// 5. If no equilibrium point exists, return -1.
//
// Time Complexity: O(n)
// Space Complexity: O(n)

class Solution {
public:
    int findEquilibrium(vector<int> &arr) {
        
        int n = arr.size();

        vector<int> prefixSum(n), suffixSum(n);

        // Calculate prefix sums
        prefixSum[0] = arr[0];

        for (int i = 1; i < n; i++) {
            prefixSum[i] = prefixSum[i - 1] + arr[i];
        }

        // Calculate suffix sums
        suffixSum[n - 1] = arr[n - 1];

        for (int i = n - 2; i >= 0; i--) {
            suffixSum[i] = suffixSum[i + 1] + arr[i];
        }

        // Find equilibrium point
        for (int i = 0; i < n; i++) {
            if (prefixSum[i] == suffixSum[i]) {
                return i;
            }
        }

        return -1;
    }
};

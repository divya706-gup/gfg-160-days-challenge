// GFG 160 Days Challenge - Day 66
// Problem: Implement Pow
//
// Approach:
// 1. Use recursion with exponentiation by squaring.
// 2. If exponent is 0, return 1.
// 3. If exponent is negative, calculate 1 / power(b, -e).
// 4. Calculate power for e/2 recursively.
// 5. If exponent is even, return temp * temp.
// 6. If exponent is odd, return b * temp * temp.
//
// Time Complexity: O(log n)
// Space Complexity: O(log n)

class Solution {
public:

    double solve(double N, int e) {

        if (e == 0) {
            return 1;
        }

        if (e < 0) {
            return 1 / solve(N, -e);
        }

        double temp = solve(N, e / 2);

        if (e % 2 == 0) {
            return temp * temp;
        }
        else {
            return N * temp * temp;
        }
    }

    double power(double b, int e) {
        return solve(b, e);
    }
};

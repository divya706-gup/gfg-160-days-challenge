// Day 22 - Find H-Index
// GFG 160 Days DSA Challenge

class Solution {
public:
    int hIndex(vector<int>& citations) {
        int n = citations.size();

        // Sort citations
        sort(citations.begin(), citations.end());

        // Check for maximum H-index
        for (int i = 0; i < n; i++) {
            int papers = n - i;

            if (citations[i] >= papers) {
                return papers;
            }
        }

        return 0;
    }
};

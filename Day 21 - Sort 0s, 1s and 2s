// Day 21 - Sort 0s, 1s and 2s
// GFG 160 Days DSA Challenge

class Solution {
public:
    void sort012(vector<int>& arr) {
        int zeroCount = 0;
        int oneCount = 0;
        int twoCount = 0;

        int n = arr.size();

        // Count 0s, 1s and 2s
        for (int i = 0; i < n; i++) {
            if (arr[i] == 0) {
                zeroCount++;
            }
            else if (arr[i] == 1) {
                oneCount++;
            }
            else {
                twoCount++;
            }
        }

        // Fill 0s
        int j = 0;

        while (zeroCount && j < n) {
            arr[j] = 0;
            zeroCount--;
            j++;
        }

        // Fill 1s
        while (oneCount && j < n) {
            arr[j] = 1;
            oneCount--;
            j++;
        }

        // Fill 2s
        while (twoCount && j < n) {
            arr[j] = 2;
            twoCount--;
            j++;
        }
    }
};

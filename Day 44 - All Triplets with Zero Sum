// GFG 160 Days Challenge - Day 44
// Problem: All Triplets with Zero Sum
//
// Approach:
// 1. Store each element along with its indices using an unordered_map.
// 2. Pick the first two elements i and j.
// 3. Calculate the required third element:
//    target = -(arr[i] + arr[j])
// 4. Check if the target exists in the map.
// 5. Add the triplet only when k > j to maintain i < j < k.
//
// Time Complexity: O(n^2 + number of valid triplets)
// Space Complexity: O(n + number of stored indices)

class Solution {
public:
    vector<vector<int>> findTriplets(vector<int> &arr) {
        unordered_map<int, vector<int>> mp;
        vector<vector<int>> ans;

        for (int i = 0; i < arr.size(); i++) {
            mp[arr[i]].push_back(i);
        }

        for (int i = 0; i < arr.size() - 2; i++) {
            for (int j = i + 1; j < arr.size() - 1; j++) {

                int target = -(arr[i] + arr[j]);

                if (mp.count(target)) {
                    for (int k : mp[target]) {
                        if (k > j) {
                            ans.push_back({i, j, k});
                        }
                    }
                }
            }
        }

        return ans;
    }
};

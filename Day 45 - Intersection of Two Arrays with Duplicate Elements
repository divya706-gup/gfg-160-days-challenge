// GFG 160 Days Challenge - Day 45
// Problem: Intersection of Two Arrays with Duplicate Elements
//
// Approach:
// 1. Store all elements of the first array in an unordered_set.
// 2. Traverse the second array.
// 3. If an element exists in the set, add it to the result.
// 4. Erase the element after adding it to avoid duplicates.
//
// Time Complexity: O(n + m)
// Space Complexity: O(n)

class Solution {
public:
    vector<int> intersect(vector<int>& a, vector<int>& b) {
        unordered_set<int> mp(a.begin(), a.end());
        vector<int> result;

        for (int i = 0; i < b.size(); i++) {
            if (mp.find(b[i]) != mp.end()) {
                result.push_back(b[i]);
                mp.erase(b[i]);
            }
        }

        return result;
    }
};

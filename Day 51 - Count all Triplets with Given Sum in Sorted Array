// GFG 160 Days Challenge - Day 51
// Problem: Count all Triplets with Given Sum in Sorted Array
//
// Approach:
// 1. Fix the first element of the triplet.
// 2. Use two pointers: left and right.
// 3. If the current sum is smaller than target, move left forward.
// 4. If the current sum is greater than target, move right backward.
// 5. When the sum equals target, count duplicate elements carefully.
// 6. Add the number of possible pairs to the answer.
//
// Time Complexity: O(n^2)
// Space Complexity: O(1)

class Solution {
public:
    int countTriplets(vector<int> &arr, int target) {

        int n = arr.size();
        int res = 0;

        for (int i = 0; i < n - 2; i++) {

            int left = i + 1;
            int right = n - 1;

            while (left < right) {

                int sum = arr[i] + arr[left] + arr[right];

                if (sum < target) {
                    left++;
                }
                else if (sum > target) {
                    right--;
                }
                else {

                    int a = arr[left];
                    int b = arr[right];

                    int cnt1 = 0;
                    int cnt2 = 0;

                    while (left <= right && arr[left] == a) {
                        left++;
                        cnt1++;
                    }

                    while (left <= right && arr[right] == b) {
                        right--;
                        cnt2++;
                    }

                    if (a == b) {
                        res += (cnt1 * (cnt1 - 1)) / 2;
                    }
                    else {
                        res += cnt1 * cnt2;
                    }
                }
            }
        }

        return res;
    }
};

// GFG 160 Days Challenge - Day 112
// Problem: Longest Common Subsequence
//
// Approach:
// 1. Use a 2D DP table to store LCS lengths.
// 2. If characters match, add 1 to the diagonal value.
// 3. Otherwise, take the maximum of the top and left values.
// 4. Return dp[n][m].
//
// Time Complexity: O(n * m)
// Space Complexity: O(n * m)

class Solution {
public:
    int lcs(string &s1, string &s2) {
        int n = s1.length();
        int m = s2.length();

        vector<vector<int>> dp(n + 1, vector<int>(m + 1, 0));

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {

                if (s1[i - 1] == s2[j - 1]) {
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                }
                else {
                    dp[i][j] = max(dp[i - 1][j],
                                   dp[i][j - 1]);
                }
            }
        }

        return dp[n][m];
    }
};

// GFG 160 Days Challenge - Day 77
// Problem: First Node of Loop in Linked List
//
// Approach:
// 1. Use Floyd's Cycle Detection Algorithm.
// 2. Move slow by one step and fast by two steps.
// 3. If they meet, a loop exists.
// 4. Move slow back to head.
// 5. Move both pointers one step at a time.
// 6. Their meeting point is the first node of the loop.
//
// Time Complexity: O(n)
// Space Complexity: O(1)

class Solution {
public:
    int cycleStart(Node* head) {
        Node* slow = head;
        Node* fast = head;

        // Detect whether a loop exists
        while (fast != NULL && fast->next != NULL) {
            slow = slow->next;
            fast = fast->next->next;

            if (slow == fast) {
                // Find the first node of the loop
                slow = head;

                while (slow != fast) {
                    slow = slow->next;
                    fast = fast->next;
                }

                return slow->data;
            }
        }

        // No loop exists
        return -1;
    }
};

// GFG 160 Days Challenge - Day 94
// Problem: Serialize and Deserialize a Binary Tree
//
// Approach:
// 1. Use Level Order Traversal (BFS) for serialization.
// 2. Store -1 for NULL nodes.
// 3. For deserialization, recreate the root.
// 4. Use a queue to reconstruct left and right children.
// 5. Preserve the original tree structure.
//
// Time Complexity: O(n) for both operations
// Space Complexity: O(n)

class Solution {
public:

    // Serialize the tree into an array
    vector<int> serialize(Node* root) {
        vector<int> ans;

        if (root == nullptr) {
            return {-1};
        }

        queue<Node*> q;
        q.push(root);

        while (!q.empty()) {
            Node* curr = q.front();
            q.pop();

            if (curr == nullptr) {
                ans.push_back(-1);
                continue;
            }

            ans.push_back(curr->data);

            q.push(curr->left);
            q.push(curr->right);
        }

        return ans;
    }

    // Deserialize the array into a tree
    Node* deSerialize(vector<int>& arr) {
        if (arr.empty() || arr[0] == -1) {
            return nullptr;
        }

        Node* root = new Node(arr[0]);

        queue<Node*> q;
        q.push(root);

        int i = 1;

        while (!q.empty() && i < arr.size()) {
            Node* curr = q.front();
            q.pop();

            // Construct left child
            if (arr[i] != -1) {
                curr->left = new Node(arr[i]);
                q.push(curr->left);
            }
            i++;

            // Construct right child
            if (i < arr.size() && arr[i] != -1) {
                curr->right = new Node(arr[i]);
                q.push(curr->right);
            }
            i++;
        }

        return root;
    }
};

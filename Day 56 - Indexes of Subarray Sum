// GFG 160 Days Challenge - Day 56
// Problem: Indexes of Subarray Sum
//
// Approach:
// 1. Use the Sliding Window / Two Pointer technique.
// 2. Expand the window by adding elements from the right.
// 3. If the current sum becomes greater than target,
//    remove elements from the left.
// 4. When the sum becomes equal to target, return the
//    1-based starting and ending indices.
// 5. If no subarray is found, return {-1}.
//
// Time Complexity: O(n)
// Space Complexity: O(1)

class Solution {
public:
    vector<int> subarraySum(vector<int> &arr, int target) {

        int n = arr.size();
        int left = 0;
        int sum = 0;

        for (int right = 0; right < n; right++) {

            sum += arr[right];

            while (sum > target && left < right) {
                sum -= arr[left];
                left++;
            }

            if (sum == target) {
                return {left + 1, right + 1};
            }
        }

        return {-1};
    }
};

// GFG 160 Days Challenge - Day 65
// Problem: Distinct Permutations of String
//
// Approach:
// 1. Use recursion and backtracking to generate all permutations.
// 2. At every index, swap the current character with each character
//    from the current index to the end.
// 3. Recursively generate permutations for the next index.
// 4. Store every permutation in a set to automatically remove duplicates.
// 5. Convert the set into a vector and return the result.
//
// Time Complexity: O(n * n!)
// Space Complexity: O(n * n!)

class Solution {
public:

    void solve(set<string>& st, int index, string s) {

        // Base case
        if (index == s.size()) {
            st.insert(s);
            return;
        }

        // Try every character at current index
        for (int i = index; i < s.size(); i++) {

            swap(s[index], s[i]);

            // Recursive call
            solve(st, index + 1, s);

            // Backtracking
            swap(s[index], s[i]);
        }
    }

    vector<string> findPermutation(string &s) {

        set<string> st;

        solve(st, 0, s);

        vector<string> ans(st.begin(), st.end());

        return ans;
    }
};

/*
    GFG 160 Days DSA Challenge
    Day 06 - Majority Element - More Than n/3

    Problem:
    Given an array of n integers, find all elements that occur
    more than floor(n/3) times.

    The result must be returned in strictly increasing order.

    Example:
    Input  : [2, 2, 3, 1, 2, 1, 1, 1]
    Output : [1, 2]

    Intuition:
    Count the frequency of every element using an unordered_map.
    Then check which elements occur more than n/3 times.

    Approach:
    1. Store the frequency of every element in an unordered_map.
    2. Traverse the map.
    3. If frequency > n/3, add the element to the result.
    4. Sort the result in increasing order.

    Time Complexity:
    O(n + k log k)
    where k is the number of majority elements.

    Space Complexity:
    O(n)
*/

#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<int> findMajority(vector<int>& arr) {

        vector<int> result;

        unordered_map<int, int> mp;

        // Count frequency of each element
        for (int i = 0; i < arr.size(); i++) {
            mp[arr[i]]++;
        }

        // Find elements occurring more than n/3 times
        for (auto m : mp) {
            if (m.second > arr.size() / 3) {
                result.push_back(m.first);
            }
        }

        // Required in strictly increasing order
        sort(result.begin(), result.end());

        return result;
    }
};
